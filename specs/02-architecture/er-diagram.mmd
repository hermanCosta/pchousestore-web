    EMPLOYEE ||--o{ DAILY_CLOSING : responsible_for

    COMPANY {
      bigint id PK
      varchar name
      varchar time_zone
      boolean is_active
    }
    SHOP {
      bigint id PK
      bigint company_id FK
      varchar code UK
      varchar name
      boolean is_active
    }
    SHOP_ACCESS_CREDENTIAL {
      bigint shop_id PK,FK
      varchar password_hash
      boolean is_active
    }
    SHOP_SESSION {
      bigint id PK
      bigint shop_id FK
      varchar oidc_authorization_id
      datetime issued_at
      datetime idle_expires_at
      datetime absolute_expires_at
      datetime revoked_at
    }
    PERSON {
      bigint id PK
      bigint company_id FK
      varchar name
      varchar contact_no
      varchar email
    }
    EMPLOYEE {
      bigint id PK
      bigint company_id FK
      bigint person_id FK
      varchar employee_code
      varchar credential_hash
      boolean is_active
    }
    EMPLOYEE_ROLE_ASSIGNMENT {
        bigint id PK
        bigint employee_id FK
        varchar role_code "combination policy OPEN"
        boolean is_active
    }
    EMPLOYEE_ACTION_AUTHORIZATION {
      bigint id PK
      bigint company_id FK
      bigint shop_session_id FK
      bigint shop_id FK
      bigint employee_id FK
      varchar action_code
      binary operation_context_hash nullable
      datetime authenticated_at
      datetime expires_at
      datetime consumed_at
    }
    CUSTOMER {
      bigint id PK
      bigint company_id FK
      bigint person_id FK
      text notes
    }
    CATALOG_ITEM {
      bigint id PK
      bigint company_id FK
      varchar kind
      varchar name
      decimal list_price
    }
    PRODUCT {
      bigint catalog_item_id PK,FK
      bigint company_id FK
    }
    SERVICE {
      bigint catalog_item_id PK,FK
      bigint company_id FK
      text description
    }
    REFURBISHED_PRODUCT {
      bigint product_catalog_item_id PK,FK
      bigint company_id FK
      varchar serial_number
    }
    SHOP_INVENTORY {
      bigint id PK
      bigint shop_id FK
      bigint product_catalog_item_id FK
      decimal quantity_on_hand
      decimal minimum_quantity
    }
    INVENTORY_MOVEMENT {
      bigint id PK
      bigint shop_inventory_id FK
      bigint employee_action_authorization_id FK
      varchar movement_kind
      decimal quantity_delta
      datetime occurred_at
    }
    DEVICE {
      bigint id PK
      bigint company_id FK
      bigint customer_id FK
      varchar brand
      varchar model
      varchar serial_number
    }
    FAULT {
      bigint id PK
      bigint company_id FK
      varchar code
      varchar description
    }
    SALE {
      bigint id PK
      bigint shop_id FK
      bigint customer_id FK
      bigint seller_employee_id FK
      bigint employee_action_authorization_id FK
      varchar status
      decimal total_amount
    }
    SALE_ITEM {
      bigint id PK
      bigint sale_id FK
      bigint catalog_item_id FK
      varchar description_snapshot
      decimal quantity
      decimal unit_price
      decimal line_total
    }
    SERVICE_ORDER {
      bigint id PK
      bigint shop_id FK
      bigint customer_id FK
      bigint device_id FK
      bigint responsible_employee_id FK
      bigint employee_action_authorization_id FK
      varchar status
      decimal total_amount
    }
    SERVICE_ORDER_ITEM {
      bigint id PK
      bigint service_order_id FK
      bigint catalog_item_id FK
      varchar description_snapshot
      decimal quantity
      decimal unit_price
      decimal line_total
    }
    SERVICE_ORDER_FAULT {
      bigint id PK
      bigint service_order_id FK
      bigint fault_id FK
    }
    SERVICE_ORDER_EVENT {
      bigint id PK
      bigint service_order_id FK
      bigint shop_id FK
      bigint employee_id FK
      bigint employee_action_authorization_id FK
      varchar event_type
      varchar from_status
      varchar to_status
      datetime occurred_at
    }
    BUSINESS_NOTE {
      bigint id PK
      bigint sale_id FK
      bigint service_order_id FK
      bigint employee_action_authorization_id FK
      text note
    }
    PAYMENT_TRANSACTION {
      bigint id PK
      bigint shop_id FK
      bigint employee_id FK
      bigint employee_action_authorization_id FK
      bigint sale_id FK
      bigint service_order_id FK
      varchar kind
      decimal amount
      bigint original_transaction_id FK
    }
    PAYMENT_ALLOCATION {
      bigint id PK
      bigint payment_transaction_id FK
      varchar method
      decimal amount_applied
      decimal amount_tendered
      decimal change_amount
    }
    CASH_MOVEMENT {
      bigint id PK
      bigint shop_id FK
      bigint employee_id FK
      bigint employee_action_authorization_id FK
      varchar direction
      decimal amount
      datetime occurred_at
    }
    DAILY_CLOSING {
      bigint id PK
      bigint shop_id FK
      date business_date UK
      bigint closing_employee_id FK
      bigint employee_action_authorization_id FK
      decimal expected_cash
      decimal counted_cash
      decimal cash_difference
        SUPPLIER {
      bigint id PK
      bigint company_id FK
      varchar name
      varchar website
      boolean is_active
    }
    SUPPLIER_PURCHASE {
      bigint id PK
      bigint shop_id FK
      bigint supplier_id FK
      varchar external_order_reference
      varchar purchase_url
      varchar tracking_url
      datetime ordered_at
      datetime expected_delivery_at
      varchar status
      char currency_code
    }
    SUPPLIER_PURCHASE_LINE {
      bigint id PK
      bigint supplier_purchase_id FK
      bigint product_catalog_item_id FK
      int quantity_ordered
      int quantity_received
      decimal unit_cost
      varchar product_url
    }
    SERVICE_PART_REQUIREMENT {
      bigint id PK
      bigint service_order_id FK
      bigint service_order_item_id FK
      int required_quantity
      boolean blocks_work
      varchar status
    }
    SERVICE_PROCUREMENT_REQUEST {
      bigint id PK
      bigint shop_id FK
      bigint service_order_id FK
      int request_number
      varchar status
      varchar priority
      datetime requested_at
      date needed_by
      bigint assigned_employee_id FK
    }
    SERVICE_PROCUREMENT_REQUEST_LINE {
      bigint id PK
      bigint service_procurement_request_id FK
      bigint service_part_requirement_id FK
      int quantity_requested
      varchar part_number_snapshot
      text compatibility_notes
    }
    SERVICE_PROCUREMENT_REQUEST_IMAGE {
      bigint id PK
      bigint service_procurement_request_line_id FK
      bigint stored_image_id FK
      varchar content_type
      bigint size_bytes
      char sha256
      varchar image_role
      bigint uploaded_by_employee_id FK
      datetime uploaded_at
    }
    SERVICE_PROCUREMENT_REQUEST_EVENT {
      bigint id PK
      bigint service_procurement_request_id FK
      bigint service_procurement_request_line_id FK
      bigint employee_id FK
      bigint employee_action_authorization_id FK
      varchar event_type
      json payload_json
      datetime occurred_at
    }
    SERVICE_PART_PROCUREMENT_ALLOCATION {
      bigint id PK
      bigint supplier_purchase_line_id FK
      bigint service_procurement_request_line_id FK
      int quantity_allocated
      int quantity_received
    }
    SUPPLIER_PURCHASE_EVENT {
      bigint id PK
      bigint supplier_purchase_id FK
      bigint employee_id FK
      bigint employee_action_authorization_id FK
      varchar event_type
      datetime expected_delivery_at_snapshot
      datetime occurred_at
    }
}


  STORED_IMAGE {
      bigint id PK
      bigint company_id FK
      bigint shop_id FK
      mediumblob content
      blob thumbnail_content
      varchar content_type
      int size_bytes
      binary sha256
  }
