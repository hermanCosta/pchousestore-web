erDiagram
    %% Authorization composite FKs: (shop_session_id,shop_id), (shop_id,company_id), (employee_id,company_id).
    COMPANY ||--o{ SHOP : operates
    SHOP ||--|| SHOP_ACCESS_CREDENTIAL : authenticates_with
    SHOP ||--o{ SHOP_SESSION : opens
    EMPLOYEE ||--o{ EMPLOYEE_ROLE_ASSIGNMENT : receives_company_role
    SHOP_SESSION ||--o{ EMPLOYEE_ACTION_AUTHORIZATION : hosts
    SHOP ||--o{ EMPLOYEE_ACTION_AUTHORIZATION : scopes
    EMPLOYEE ||--o{ EMPLOYEE_ACTION_AUTHORIZATION : authenticates_for_action

    COMPANY ||--o{ PERSON : owns
    COMPANY ||--o{ EMPLOYEE : employs
    COMPANY ||--o{ CUSTOMER : serves
    PERSON ||--o{ EMPLOYEE : identifies
    PERSON ||--o{ CUSTOMER : identifies

    COMPANY ||--o{ CATALOG_ITEM : defines
    CATALOG_ITEM ||--o| PRODUCT : specializes
    CATALOG_ITEM ||--o| SERVICE : specializes
    PRODUCT ||--o| REFURBISHED_PRODUCT : extends
    SHOP ||--o{ SHOP_INVENTORY : stores
    PRODUCT ||--o{ SHOP_INVENTORY : balance_per_shop
    SHOP_INVENTORY ||--o{ INVENTORY_MOVEMENT : records
    EMPLOYEE_ACTION_AUTHORIZATION ||--o| INVENTORY_MOVEMENT : authorizes

    CUSTOMER ||--o{ DEVICE : owns
    COMPANY ||--o{ DEVICE : registers
    COMPANY ||--o{ FAULT : defines

    SHOP ||--o{ SALE : records
    CUSTOMER o|--o{ SALE : buys
    EMPLOYEE ||--o{ SALE : sells
    EMPLOYEE_ACTION_AUTHORIZATION ||--o| SALE : authorizes
    SALE ||--|{ SALE_ITEM : contains
    CATALOG_ITEM ||--o{ SALE_ITEM : referenced_by

    SHOP ||--o{ SERVICE_ORDER : records
    CUSTOMER ||--o{ SERVICE_ORDER : requests
    DEVICE o|--o{ SERVICE_ORDER : serviced_in
    EMPLOYEE ||--o{ SERVICE_ORDER : responsible_for
    EMPLOYEE_ACTION_AUTHORIZATION ||--o| SERVICE_ORDER : authorizes_creation
    SERVICE_ORDER ||--|{ SERVICE_ORDER_ITEM : contains
    SERVICE_ORDER ||--o{ SERVICE_PART_REQUIREMENT : requires_parts
    SERVICE_ORDER_ITEM ||--o| SERVICE_PART_REQUIREMENT : part_requirement_for
    SERVICE_ORDER ||--o{ SERVICE_PROCUREMENT_REQUEST : requests_parts_in_rounds
    SHOP ||--o{ SERVICE_PROCUREMENT_REQUEST : queues
    SERVICE_PROCUREMENT_REQUEST ||--|{ SERVICE_PROCUREMENT_REQUEST_LINE : contains
    SERVICE_PART_REQUIREMENT ||--o{ SERVICE_PROCUREMENT_REQUEST_LINE : sourced_in_rounds
    SERVICE_PROCUREMENT_REQUEST_LINE ||--o{ SERVICE_PROCUREMENT_REQUEST_IMAGE : illustrated_by
    SERVICE_PROCUREMENT_REQUEST ||--o{ SERVICE_PROCUREMENT_REQUEST_EVENT : audit_history
    EMPLOYEE ||--o{ SERVICE_PROCUREMENT_REQUEST_EVENT : performs
    EMPLOYEE_ACTION_AUTHORIZATION ||--o| SERVICE_PROCUREMENT_REQUEST_EVENT : authorizes
    COMPANY ||--o{ SUPPLIER : registers
    SUPPLIER o|--o{ SUPPLIER_PURCHASE : source_for
    SHOP ||--o{ SUPPLIER_PURCHASE : places
    SUPPLIER_PURCHASE ||--|{ SUPPLIER_PURCHASE_LINE : contains
    PRODUCT ||--o{ SUPPLIER_PURCHASE_LINE : ordered_product
    SERVICE_PROCUREMENT_REQUEST_LINE ||--o{ SERVICE_PART_PROCUREMENT_ALLOCATION : ordered_through
    SUPPLIER_PURCHASE_LINE ||--o{ SERVICE_PART_PROCUREMENT_ALLOCATION : allocated_to
    SUPPLIER_PURCHASE ||--o{ SUPPLIER_PURCHASE_EVENT : tracks
    SUPPLIER_PURCHASE_LINE ||--o{ INVENTORY_MOVEMENT : receipt_movements
    EMPLOYEE ||--o{ SUPPLIER_PURCHASE_EVENT : updates
    EMPLOYEE_ACTION_AUTHORIZATION ||--o| SUPPLIER_PURCHASE_EVENT : authorizes

    CATALOG_ITEM ||--o{ SERVICE_ORDER_ITEM : referenced_by
    SERVICE_ORDER ||--|{ SERVICE_ORDER_FAULT : reports
    FAULT ||--o{ SERVICE_ORDER_FAULT : applied_to
    SERVICE_ORDER ||--o{ SERVICE_ORDER_EVENT : records_actions
    EMPLOYEE ||--o{ SERVICE_ORDER_EVENT : performs
    EMPLOYEE_ACTION_AUTHORIZATION ||--o| SERVICE_ORDER_EVENT : authorizes

    EMPLOYEE_ACTION_AUTHORIZATION ||--o| BUSINESS_NOTE : authorizes
    SALE o|--o{ BUSINESS_NOTE : may_have
    SERVICE_ORDER o|--o{ BUSINESS_NOTE : may_have

    SHOP ||--o{ PAYMENT_TRANSACTION : records
    EMPLOYEE ||--o{ PAYMENT_TRANSACTION : performs
    EMPLOYEE_ACTION_AUTHORIZATION ||--o| PAYMENT_TRANSACTION : authorizes
    SALE o|--o{ PAYMENT_TRANSACTION : target
    SERVICE_ORDER o|--o{ PAYMENT_TRANSACTION : target
    PAYMENT_TRANSACTION ||--|{ PAYMENT_ALLOCATION : split_into
    PAYMENT_TRANSACTION o|--o{ PAYMENT_TRANSACTION : refunded_by

    SHOP ||--o{ CASH_MOVEMENT : records
    EMPLOYEE ||--o{ CASH_MOVEMENT : performs
    EMPLOYEE_ACTION_AUTHORIZATION ||--o| CASH_MOVEMENT : authorizes
