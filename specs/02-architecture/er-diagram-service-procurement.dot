digraph SERVICE_PARTS_PROCUREMENT {
 graph [rankdir=LR, splines=polyline, nodesep=.48, ranksep=.72, pad=.35, bgcolor="white", fontname="Arial", fontsize=18, labelloc=t, label="pcHouseStore Web — Service Parts Purchase Queue DER\nMultiple request rounds per ServiceOrder | reference images | consolidated supplier purchases | partial receipts"];
 node [shape=plain, fontname="Arial", fontsize=9]; edge [fontname="Arial", fontsize=8, color="#526273", arrowsize=.7];
 storedimage [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#DCEAFE"><B>STORED_IMAGE</B></TD></TR><TR><TD ALIGN="LEFT">PK id; FK company_id, shop_id</TD></TR><TR><TD ALIGN="LEFT">content MEDIUMBLOB; thumbnail BLOB</TD></TR><TR><TD ALIGN="LEFT">content_type, size, SHA-256</TD></TR></TABLE> >];
 serviceorder [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#DCEAFE"><B>SERVICE_ORDER</B></TD></TR><TR><TD ALIGN="LEFT">PK id; FK shop_id</TD></TR><TR><TD ALIGN="LEFT">Service ID searched in queue</TD></TR><TR><TD ALIGN="LEFT">CREATED / AWAITING_PARTS / IN_PROGRESS ...</TD></TR></TABLE> >];
 serviceitem [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#DCEAFE"><B>SERVICE_ORDER_ITEM</B></TD></TR><TR><TD ALIGN="LEFT">PK id; FK service_order_id</TD></TR><TR><TD ALIGN="LEFT">FK catalog_item_id (PRODUCT)</TD></TR><TR><TD ALIGN="LEFT">quantity INT</TD></TR></TABLE> >];
 requirement [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#FEF3C7"><B>SERVICE_PART_REQUIREMENT</B></TD></TR><TR><TD ALIGN="LEFT">PK id; FK service_order_id, service_order_item_id</TD></TR><TR><TD ALIGN="LEFT">required_quantity INT; blocks_work</TD></TR><TR><TD ALIGN="LEFT">Durable total demand / reservation status</TD></TR></TABLE> >];
 request [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#FCE7F3"><B>SERVICE_PROCUREMENT_REQUEST</B></TD></TR><TR><TD ALIGN="LEFT">PK id; FK shop_id, service_order_id</TD></TR><TR><TD ALIGN="LEFT">request_number unique per ServiceOrder</TD></TR><TR><TD ALIGN="LEFT">status, priority, needed_by, assigned_employee_id</TD></TR><TR><TD ALIGN="LEFT">One request = one sourcing round; many per service</TD></TR></TABLE> >];
 requestline [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#FCE7F3"><B>SERVICE_PROCUREMENT_REQUEST_LINE</B></TD></TR><TR><TD ALIGN="LEFT">PK id; FK request_id, requirement_id</TD></TR><TR><TD ALIGN="LEFT">quantity_requested INT</TD></TR><TR><TD ALIGN="LEFT">part_number_snapshot, compatibility_notes</TD></TR></TABLE> >];
 image [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#EDE9FE"><B>SERVICE_PROCUREMENT_REQUEST_IMAGE</B></TD></TR><TR><TD ALIGN="LEFT">PK id; FK request_line_id</TD></TR><TR><TD ALIGN="LEFT">FK stored_image_id; image_role, caption</TD></TR><TR><TD ALIGN="LEFT">Image bytes in MySQL STORED_IMAGE</TD></TR></TABLE> >];
 requestevent [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#EDE9FE"><B>SERVICE_PROCUREMENT_REQUEST_EVENT</B></TD></TR><TR><TD ALIGN="LEFT">PK id; FK request_id, request_line_id?</TD></TR><TR><TD ALIGN="LEFT">event_type, status/priority snapshot, payload_json</TD></TR><TR><TD ALIGN="LEFT">employee_id + one-use authorization; occurred_at</TD></TR></TABLE> >];
 supplier [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#EDE9FE"><B>SUPPLIER</B></TD></TR><TR><TD ALIGN="LEFT">PK id; FK company_id</TD></TR><TR><TD ALIGN="LEFT">name, website, contact</TD></TR></TABLE> >];
 purchase [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#FCE7F3"><B>SUPPLIER_PURCHASE</B></TD></TR><TR><TD ALIGN="LEFT">PK id; FK shop_id, supplier_id?</TD></TR><TR><TD ALIGN="LEFT">external_order_reference, purchase_url</TD></TR><TR><TD ALIGN="LEFT">ordered_at, expected_delivery_at</TD></TR><TR><TD ALIGN="LEFT">tracking_reference, tracking_url, status</TD></TR></TABLE> >];
 line [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#FCE7F3"><B>SUPPLIER_PURCHASE_LINE</B></TD></TR><TR><TD ALIGN="LEFT">PK id; FK supplier_purchase_id, product_catalog_item_id</TD></TR><TR><TD ALIGN="LEFT">quantity_ordered INT; quantity_received INT</TD></TR><TR><TD ALIGN="LEFT">unit_cost; product_url</TD></TR></TABLE> >];
 allocation [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#DCFCE7"><B>SERVICE_PART_PROCUREMENT_ALLOCATION</B></TD></TR><TR><TD ALIGN="LEFT">PK id; FK purchase_line_id, request_line_id</TD></TR><TR><TD ALIGN="LEFT">quantity_allocated INT; quantity_received INT</TD></TR><TR><TD ALIGN="LEFT">Purchase can serve multiple requests</TD></TR></TABLE> >];
 event [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#EDE9FE"><B>SUPPLIER_PURCHASE_EVENT</B></TD></TR><TR><TD ALIGN="LEFT">PK id; FK supplier_purchase_id</TD></TR><TR><TD ALIGN="LEFT">status / ETA / tracking snapshots; notes</TD></TR><TR><TD ALIGN="LEFT">employee_id + one-use authorization; occurred_at</TD></TR></TABLE> >];
 inventory [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#DCFCE7"><B>SHOP_INVENTORY / INVENTORY_MOVEMENT</B></TD></TR><TR><TD ALIGN="LEFT">Actual accepted receipt only</TD></TR><TR><TD ALIGN="LEFT">PURCHASE_RECEIPT_IN; integer quantity delta</TD></TR><TR><TD ALIGN="LEFT">Allocated qty auto-reserved for linked requirement</TD></TR></TABLE> >];
 shop [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#DCEAFE"><B>SHOP</B></TD></TR><TR><TD ALIGN="LEFT">PK id; FK company_id</TD></TR></TABLE> >];
 product [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#DCFCE7"><B>PRODUCT / CATALOG_ITEM</B></TD></TR><TR><TD ALIGN="LEFT">PK catalog_item_id</TD></TR><TR><TD ALIGN="LEFT">kind must equal PRODUCT</TD></TR></TABLE> >];
 employee [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#F1F5F9"><B>EMPLOYEE / ACTION AUTHORIZATION</B></TD></TR><TR><TD ALIGN="LEFT">Request creation, image upload, updates, purchasing and receipt</TD></TR><TR><TD ALIGN="LEFT">Each write is individually authenticated and audited</TD></TR></TABLE> >];
 serviceorder -> serviceitem [label="1:N"];
 serviceorder -> requirement [label="1:N"];
 serviceitem -> requirement [label="0..1 per product line"];
 serviceorder -> request [label="1:N; many rounds over time"];
 shop -> request [label="1:N; active Shop scope"];
 request -> requestline [label="1:N"];
 requirement -> requestline [label="1:N across sourcing rounds"];
 requestline -> image [label="1:N reference photos"]; storedimage -> image [label="1:1 MySQL BLOB"] ;
 request -> requestevent [label="1:N immutable audit history"];
 employee -> requestevent [label="actor + authorization"];
 employee -> event [label="actor + authorization"];
 shop -> purchase [label="1:N"];
 supplier -> purchase [label="0..1 source"];
 purchase -> line [label="1:N"];
 product -> line [label="only PRODUCT"];
 line -> allocation [label="1:N"];
 requestline -> allocation [label="1:N; split sourcing"];
 purchase -> event [label="1:N timeline"];
 employee -> event [label="actor + authorization"];
 requestline -> employee [style=dashed, label="uploaded_by / assigned buyer"];
 line -> inventory [style=dashed, label="partial/full accepted receipt"];
 allocation -> inventory [style=dashed, label="reserve allocated qty"];
}
