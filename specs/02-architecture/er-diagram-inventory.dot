digraph INVENTORY {
 graph [rankdir=LR, splines=polyline, nodesep=.50, ranksep=.90, pad=.35, bgcolor="white", fontname="Arial", fontsize=18, labelloc=t, label="pcHouseStore Web — Inventory DER\nInteger product stock | reservations | selected returns | Shop transfers | serialized refurbished units"];
 node [shape=plain, fontname="Arial", fontsize=10]; edge [fontname="Arial", fontsize=9, color="#526273", arrowsize=.7];
 storedimage [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#DCEAFE"><B>STORED_IMAGE</B></TD></TR><TR><TD ALIGN="LEFT">PK id; content MEDIUMBLOB</TD></TR><TR><TD ALIGN="LEFT">thumbnail BLOB; MIME; SHA-256</TD></TR></TABLE> >];
 shop [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#DCEAFE"><B>SHOP</B></TD></TR><TR><TD ALIGN="LEFT">PK id; FK company_id</TD></TR></TABLE> >];
 catalog [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#DCFCE7"><B>CATALOG_ITEM</B></TD></TR><TR><TD ALIGN="LEFT">PK id; kind PRODUCT/SERVICE</TD></TR></TABLE> >];
 product [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#DCFCE7"><B>PRODUCT</B></TD></TR><TR><TD ALIGN="LEFT">PK/FK catalog_item_id</TD></TR><TR><TD ALIGN="LEFT">FK product_category_id</TD></TR><TR><TD ALIGN="LEFT">tracking: QUANTITY / SERIALIZED_UNIT</TD></TR></TABLE> >];
 category [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#FEF3C7"><B>PRODUCT_CATEGORY</B></TD></TR><TR><TD ALIGN="LEFT">PK id; FK parent_category_id?</TD></TR><TR><TD ALIGN="LEFT">name, code, description</TD></TR><TR><TD ALIGN="LEFT">Data-driven: PC, Console, TV...</TD></TR></TABLE> >];
 attrdef [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#FEF3C7"><B>PRODUCT_ATTRIBUTE_DEFINITION</B></TD></TR><TR><TD ALIGN="LEFT">PK id; FK product_category_id</TD></TR><TR><TD ALIGN="LEFT">code, data_type, unit, required</TD></TR></TABLE> >];
 unit [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#FCE7F3"><B>REFURBISHED_UNIT</B></TD></TR><TR><TD ALIGN="LEFT">PK id; FK product_catalog_item_id</TD></TR><TR><TD ALIGN="LEFT">FK current_shop_id?</TD></TR><TR><TD ALIGN="LEFT">asset_code, serial_number?, condition_grade</TD></TR><TR><TD ALIGN="LEFT">status: AVAILABLE / RESERVED / IN_TRANSIT / SOLD ...</TD></TR></TABLE> >];
 attrval [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#FCE7F3"><B>REFURBISHED_UNIT_ATTRIBUTE_VALUE</B></TD></TR><TR><TD ALIGN="LEFT">PK id; FK refurbished_unit_id</TD></TR><TR><TD ALIGN="LEFT">FK product_attribute_definition_id</TD></TR><TR><TD ALIGN="LEFT">typed value columns</TD></TR></TABLE> >];
 refurbimage [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#FCE7F3"><B>REFURBISHED_UNIT_IMAGE</B></TD></TR><TR><TD ALIGN="LEFT">PK id; FK refurbished_unit_id</TD></TR><TR><TD ALIGN="LEFT">FK stored_image_id; role, caption</TD></TR><TR><TD ALIGN="LEFT">Bytes stored in MySQL STORED_IMAGE</TD></TR></TABLE> >];
 refurbwarranty [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#FCE7F3"><B>REFURBISHED_UNIT_WARRANTY</B></TD></TR><TR><TD ALIGN="LEFT">PK id; FK refurbished_unit_id, sale_item_id</TD></TR><TR><TD ALIGN="LEFT">12 calendar months from customer handover</TD></TR><TR><TD ALIGN="LEFT">Commercial guarantee; statutory rights remain</TD></TR></TABLE> >];
 inventory [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#DCFCE7"><B>SHOP_INVENTORY</B></TD></TR><TR><TD ALIGN="LEFT">PK id; FK shop_id, product_catalog_item_id</TD></TR><TR><TD ALIGN="LEFT">quantity_on_hand signed INT; quantity_reserved INT greater-or-equal-0</TD></TR><TR><TD ALIGN="LEFT">available = on_hand - reserved (may be negative)</TD></TR><TR><TD ALIGN="LEFT">Only QUANTITY tracking</TD></TR></TABLE> >];
 reserve [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#EDE9FE"><B>INVENTORY_RESERVATION</B></TD></TR><TR><TD ALIGN="LEFT">PK id; FK shop_id</TD></TR><TR><TD ALIGN="LEFT">FK sale_id XOR service_order_id</TD></TR><TR><TD ALIGN="LEFT">status, created/released/consumed_at</TD></TR></TABLE> >];
 rline [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#EDE9FE"><B>INVENTORY_RESERVATION_LINE</B></TD></TR><TR><TD ALIGN="LEFT">PK id; FK reservation_id</TD></TR><TR><TD ALIGN="LEFT">FK sale_item XOR service_order_item</TD></TR><TR><TD ALIGN="LEFT">FK shop_inventory XOR refurbished_unit</TD></TR><TR><TD ALIGN="LEFT">qty_reserved / consumed / released (INT)</TD></TR></TABLE> >];
 movement [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#DCFCE7"><B>INVENTORY_MOVEMENT</B></TD></TR><TR><TD ALIGN="LEFT">PK id; FK shop_id, product</TD></TR><TR><TD ALIGN="LEFT">FK shop_inventory XOR refurbished_unit</TD></TR><TR><TD ALIGN="LEFT">signed integer delta, kind, reason</TD></TR><TR><TD ALIGN="LEFT">FK employee + one-use authorization</TD></TR></TABLE> >];
 transfer [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#FEF3C7"><B>STOCK_TRANSFER</B></TD></TR><TR><TD ALIGN="LEFT">PK id; FK source_shop_id, destination_shop_id</TD></TR><TR><TD ALIGN="LEFT">status DRAFT / IN_TRANSIT / PARTIAL / RECEIVED</TD></TR><TR><TD ALIGN="LEFT">dispatch and receipt actor/auth</TD></TR></TABLE> >];
 tline [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#FEF3C7"><B>STOCK_TRANSFER_LINE</B></TD></TR><TR><TD ALIGN="LEFT">PK id; FK stock_transfer_id, product</TD></TR><TR><TD ALIGN="LEFT">FK refurbished_unit_id?</TD></TR><TR><TD ALIGN="LEFT">requested / dispatched / received INT</TD></TR></TABLE> >];
 ret [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#FEF3C7"><B>STOCK_RETURN</B></TD></TR><TR><TD ALIGN="LEFT">PK id; FK shop_id</TD></TR><TR><TD ALIGN="LEFT">FK sale_id XOR service_order_id</TD></TR><TR><TD ALIGN="LEFT">Allowed when source is REFUNDED/CANCELLED</TD></TR></TABLE> >];
 retline [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#FEF3F3"><B>STOCK_RETURN_LINE</B></TD></TR><TR><TD ALIGN="LEFT">PK id; FK stock_return_id</TD></TR><TR><TD ALIGN="LEFT">FK sale_item XOR service_order_item</TD></TR><TR><TD ALIGN="LEFT">FK refurbished_unit_id?; quantity_returned INT</TD></TR></TABLE> >];
 catalog -> product [label="1:0..1"]; category -> product [label="1:N"]; category -> attrdef [label="1:N"];
 product -> unit [label="1:N for serialized products"]; unit -> attrval [label="1:N"]; attrdef -> attrval [label="1:N"]; unit -> refurbimage [label="1:N photo relations"]; storedimage -> refurbimage [label="1:1 MySQL BLOB"]; unit -> refurbwarranty [label="0..1 per sold unit"];
 shop -> inventory [label="1:N"]; product -> inventory [label="1:N across Shops"];
 shop -> reserve [label="1:N"]; reserve -> rline [label="1:N"]; inventory -> rline [label="target"]; unit -> rline [label="target for serialized"];
 inventory -> movement [label="1:N"]; unit -> movement [label="unit ledger"]; shop -> movement [label="1:N"];
 shop -> transfer [label="source/destination"]; transfer -> tline [label="1:N"]; product -> tline [label="1:N"]; unit -> tline [label="exact unit"];
 shop -> ret [label="1:N"]; ret -> retline [label="1:N"]; unit -> retline [label="exact unit on serialized return"];
 tline -> movement [style=dashed,label="out / in"]; retline -> movement [style=dashed,label="return in"];
}
