digraph CORE {
 graph [rankdir=LR, splines=polyline, nodesep=.45, ranksep=.85, pad=.35, bgcolor=white, fontname=Arial, fontsize=18, labelloc=t, label="pcHouseStore Web — DER (1/2)\nCompany, Shops, Shop session, Company-wide employee password/roles, shared master data and branch stock"];
 node [shape=plain, fontname=Arial, fontsize=10]; edge [fontname=Arial, fontsize=9, color="#526273", arrowsize=.7];
 company [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#DCEAFE"><B>COMPANY</B></TD></TR><TR><TD ALIGN="LEFT">PK id</TD></TR><TR><TD ALIGN="LEFT">name, time_zone, is_active</TD></TR><TR><TD ALIGN="LEFT">One legal entity in current deployment</TD></TR></TABLE> >];
 shop [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#DCEAFE"><B>SHOP</B></TD></TR><TR><TD ALIGN="LEFT">PK id; FK company_id</TD></TR><TR><TD ALIGN="LEFT">code, name, address, is_active</TD></TR></TABLE> >];
 credential [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#DCEAFE"><B>SHOP_ACCESS_CREDENTIAL</B></TD></TR><TR><TD ALIGN="LEFT">PK id; FK shop_id (unique)</TD></TR><TR><TD ALIGN="LEFT">login_code, password_hash, is_active</TD></TR></TABLE> >];
 session [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#DCEAFE"><B>SHOP_SESSION</B></TD></TR><TR><TD ALIGN="LEFT">PK id; FK shop_id</TD></TR><TR><TD ALIGN="LEFT">session_token_hash, issued_at, expires_at, revoked_at</TD></TR><TR><TD ALIGN="LEFT"><B>No employee identity in session</B></TD></TR></TABLE> >];
 person [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#DCEAFE"><B>PERSON</B></TD></TR><TR><TD ALIGN="LEFT">PK id; FK company_id</TD></TR><TR><TD ALIGN="LEFT">name, contact, email</TD></TR></TABLE> >];
 employee [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#DCEAFE"><B>EMPLOYEE</B></TD></TR><TR><TD ALIGN="LEFT">PK id; FK company_id, person_id</TD></TR><TR><TD ALIGN="LEFT">employee_code, password_hash, is_active; same credentials across Shops</TD></TR></TABLE> >];
 employeerole [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#DCEAFE"><B>EMPLOYEE_ROLE_ASSIGNMENT</B></TD></TR><TR><TD ALIGN="LEFT">PK id; FK employee_id</TD></TR><TR><TD ALIGN="LEFT">MANAGER / TECHNICIAN</TD></TR><TR><TD ALIGN="LEFT">Company-wide; applies to every Shop</TD></TR></TABLE> >];
 authorization [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#FCE7F3"><B>EMPLOYEE_ACTION_AUTHORIZATION</B></TD></TR><TR><TD ALIGN="LEFT">PK id; FK shop_session_id, shop_id, employee_id</TD></TR><TR><TD ALIGN="LEFT">action_code, operation_context_hash, authenticated_at, expires_at, consumed_at</TD></TR><TR><TD ALIGN="LEFT">Short-lived; single-use</TD></TR></TABLE> >];
 customer [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#DCEAFE"><B>CUSTOMER</B></TD></TR><TR><TD ALIGN="LEFT">PK id; FK company_id, person_id</TD></TR><TR><TD ALIGN="LEFT">notes, is_active</TD></TR><TR><TD ALIGN="LEFT">Shared across Shops</TD></TR></TABLE> >];
 catalog [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#DCFCE7"><B>CATALOG_ITEM</B></TD></TR><TR><TD ALIGN="LEFT">PK id; FK company_id</TD></TR><TR><TD ALIGN="LEFT">kind: PRODUCT | SERVICE</TD></TR><TR><TD ALIGN="LEFT">name, category, SKU, list_price</TD></TR></TABLE> >];
 product [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#DCFCE7"><B>PRODUCT</B></TD></TR><TR><TD ALIGN="LEFT">PK/FK catalog_item_id; company_id</TD></TR><TR><TD ALIGN="LEFT">Product attributes; no shop balance here</TD></TR></TABLE> >];
 service [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#DCFCE7"><B>SERVICE</B></TD></TR><TR><TD ALIGN="LEFT">PK/FK catalog_item_id; company_id</TD></TR><TR><TD ALIGN="LEFT">description; no stock</TD></TR></TABLE> >];
 refurb [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#DCFCE7"><B>REFURBISHED_PRODUCT</B></TD></TR><TR><TD ALIGN="LEFT">PK/FK product_catalog_item_id</TD></TR><TR><TD ALIGN="LEFT">category, brand, model, serial</TD></TR></TABLE> >];
 inventory [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#DCFCE7"><B>SHOP_INVENTORY</B></TD></TR><TR><TD ALIGN="LEFT">PK id; FK shop_id, product_catalog_item_id</TD></TR><TR><TD ALIGN="LEFT">quantity_on_hand, minimum_quantity</TD></TR><TR><TD ALIGN="LEFT">UNIQUE(shop_id, product_id)</TD></TR></TABLE> >];
 movement [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#DCFCE7"><B>INVENTORY_MOVEMENT</B></TD></TR><TR><TD ALIGN="LEFT">PK id; FK shop_inventory_id, employee_action_authorization_id</TD></TR><TR><TD ALIGN="LEFT">movement_kind, quantity_delta, occurred_at, reason</TD></TR></TABLE> >];
 device [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#FEF3C7"><B>DEVICE</B></TD></TR><TR><TD ALIGN="LEFT">PK id; FK company_id, customer_id</TD></TR><TR><TD ALIGN="LEFT">brand, model, serial_number</TD></TR></TABLE> >];
 fault [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#FEF3C7"><B>FAULT</B></TD></TR><TR><TD ALIGN="LEFT">PK id; FK company_id</TD></TR><TR><TD ALIGN="LEFT">code, description, is_active</TD></TR></TABLE> >];
 company -> shop [label="1:N"];
 shop -> credential [label="1:1"]; shop -> session [label="1:N"];
 company -> person [label="1:N shared"]; company -> employee [label="1:N"]; company -> customer [label="1:N shared"];
 person -> employee [label="1:N"]; person -> customer [label="1:N"];
 employee -> employeerole [label="1:N Company-wide roles"];
 session -> authorization [label="1:N"]; employee -> authorization [label="1:N"]; shop -> authorization [label="1:N"];
 company -> catalog [label="1:N shared"]; catalog -> product [label="1:0..1"]; catalog -> service [label="1:0..1"];
 product -> refurb [label="1:0..1"]; shop -> inventory [label="1:N"]; product -> inventory [label="1:N across Shops"];
 inventory -> movement [label="1:N"]; authorization -> movement [label="1:0..1 per operation"];
 company -> device [label="1:N shared"]; customer -> device [label="1:N"]; company -> fault [label="1:N shared"];
}
