digraph FINANCE {
 graph [rankdir=LR, splines=polyline, nodesep=.42, ranksep=.72, pad=.30, bgcolor=white, fontname=Arial, fontsize=17, labelloc=t, label="pcHouseStore Web — Finance DER\nIreland EUR | Company VAT flag | deposits | weekly refurb instalments | partial/total refunds | 12-month refurb guarantee | per-Shop close"];
 node [shape=plain, fontname=Arial, fontsize=9]; edge [fontname=Arial, fontsize=8, color="#526273", arrowsize=.65];
 company [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#DCEAFE"><B>COMPANY</B></TD></TR><TR><TD ALIGN="LEFT">PK id</TD></TR><TR><TD ALIGN="LEFT">country=IE; currency=EUR; time_zone=Europe/Dublin</TD></TR></TABLE> >];
 shop [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#DCEAFE"><B>SHOP</B></TD></TR><TR><TD ALIGN="LEFT">PK id; FK company_id</TD></TR></TABLE> >];
 taxconfig [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#E0F2FE"><B>COMPANY_TAX_CONFIGURATION</B></TD></TR><TR><TD ALIGN="LEFT">PK id; FK company_id (unique)</TD></TR><TR><TD ALIGN="LEFT">vat_enabled; setup_status NOT_REVIEWED / READY</TD></TR></TABLE> >];
 taxrate [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#E0F2FE"><B>COMPANY_TAX_RATE</B></TD></TR><TR><TD ALIGN="LEFT">PK id; FK company_tax_code_id</TD></TR><TR><TD ALIGN="LEFT">rate; effective_from / effective_to</TD></TR></TABLE> >];
 policy [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#E0F2FE"><B>SHOP_FINANCIAL_POLICY</B></TD></TR><TR><TD ALIGN="LEFT">PK id; FK shop_id</TD></TR><TR><TD ALIGN="LEFT">currency; cash_rounding_enabled</TD></TR><TR><TD ALIGN="LEFT">refund threshold / deposit approval</TD></TR></TABLE> >];
 method [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#E0F2FE"><B>PAYMENT_METHOD</B></TD></TR><TR><TD ALIGN="LEFT">PK id; code, family, display_name</TD></TR><TR><TD ALIGN="LEFT">requires_reference, affects_drawer</TD></TR></TABLE> >];
 shopmethod [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#E0F2FE"><B>SHOP_PAYMENT_METHOD</B></TD></TR><TR><TD ALIGN="LEFT">PK id; FK shop_id, payment_method_id</TD></TR><TR><TD ALIGN="LEFT">enabled; provider_config_ref</TD></TR></TABLE> >];
 employee [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#DCEAFE"><B>EMPLOYEE</B></TD></TR><TR><TD ALIGN="LEFT">PK id; Company-wide password</TD></TR><TR><TD ALIGN="LEFT">MANAGER / TECHNICIAN roles across Shops</TD></TR></TABLE> >];
 sale [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#FCE7F3"><B>SALE</B></TD></TR><TR><TD ALIGN="LEFT">PK id; FK shop_id</TD></TR><TR><TD ALIGN="LEFT">currency; total; balance_due</TD></TR></TABLE> >];
 so [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#FEF3C7"><B>SERVICE_ORDER</B></TD></TR><TR><TD ALIGN="LEFT">PK id; FK shop_id</TD></TR><TR><TD ALIGN="LEFT">currency; total; balance_due</TD></TR></TABLE> >];
 deposit [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#FEF3C7"><B>SERVICE_DEPOSIT</B></TD></TR><TR><TD ALIGN="LEFT">PK id; FK shop_id, service_order_id</TD></TR><TR><TD ALIGN="LEFT">purpose; target_amount; status</TD></TR><TR><TD ALIGN="LEFT">PARTS_PREORDER / ADVANCE / SECURITY</TD></TR></TABLE> >];
 depapply [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#FEF3C7"><B>DEPOSIT_APPLICATION</B></TD></TR><TR><TD ALIGN="LEFT">PK id; FK service_deposit_id, service_order_id</TD></TR><TR><TD ALIGN="LEFT">amount; employee/auth; applied_at</TD></TR><TR><TD ALIGN="LEFT">Non-cash credit</TD></TR></TABLE> >];
 payment [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#EDE9FE"><B>PAYMENT_TRANSACTION</B></TD></TR><TR><TD ALIGN="LEFT">PK id; FK shop_id, employee_id, authorization_id</TD></TR><TR><TD ALIGN="LEFT">sale_id XOR service_order_id XOR deposit_id</TD></TR><TR><TD ALIGN="LEFT">kind; positive amount; EUR; status</TD></TR><TR><TD ALIGN="LEFT">original_transaction_id?; rounding_adjustment</TD></TR></TABLE> >];
 allocation [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#EDE9FE"><B>PAYMENT_ALLOCATION</B></TD></TR><TR><TD ALIGN="LEFT">PK id; FK payment_transaction_id, payment_method_id</TD></TR><TR><TD ALIGN="LEFT">amount_applied, tendered, change</TD></TR><TR><TD ALIGN="LEFT">provider_reference?</TD></TR></TABLE> >];
 refundline [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#FEE2E2"><B>PAYMENT_REFUND_LINE</B></TD></TR><TR><TD ALIGN="LEFT">PK id; FK refund_payment_transaction_id</TD></TR><TR><TD ALIGN="LEFT">sale_item XOR service_order_item?</TD></TR><TR><TD ALIGN="LEFT">quantity?; amount_refunded; reason</TD></TR></TABLE> >];
 plan [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#DCFCE7"><B>INSTALLMENT_PLAN</B></TD></TR><TR><TD ALIGN="LEFT">PK id; FK shop_id, sale_id</TD></TR><TR><TD ALIGN="LEFT">WEEKLY; LAYAWAY / CREDIT_SALE</TD></TR><TR><TD ALIGN="LEFT">cash_price, total_payable, status</TD></TR></TABLE> >];
 schedule [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#DCFCE7"><B>INSTALLMENT_SCHEDULE</B></TD></TR><TR><TD ALIGN="LEFT">PK id; FK installment_plan_id</TD></TR><TR><TD ALIGN="LEFT">sequence, due_date, amount, status</TD></TR></TABLE> >];
 settlement [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#DCFCE7"><B>INSTALLMENT_SETTLEMENT</B></TD></TR><TR><TD ALIGN="LEFT">PK id; FK installment_schedule_id, payment_transaction_id</TD></TR><TR><TD ALIGN="LEFT">amount_applied</TD></TR></TABLE> >];
 approval [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#FCE7F3"><B>BUSINESS_ACTION_APPROVAL</B></TD></TR><TR><TD ALIGN="LEFT">PK id; FK shop_id</TD></TR><TR><TD ALIGN="LEFT">requester / approver / approval auth</TD></TR><TR><TD ALIGN="LEFT">action_code; threshold; reason; status</TD></TR></TABLE> >];
 cashmove [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#EDE9FE"><B>CASH_MOVEMENT</B></TD></TR><TR><TD ALIGN="LEFT">PK id; FK shop_id, employee_id, auth_id</TD></TR><TR><TD ALIGN="LEFT">direction IN/OUT; amount; occurred_at</TD></TR></TABLE> >];
 closing [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#EDE9FE"><B>DAILY_CLOSING</B></TD></TR><TR><TD ALIGN="LEFT">PK id; FK shop_id, closing_employee_id</TD></TR><TR><TD ALIGN="LEFT">business_date UNIQUE with shop</TD></TR><TR><TD ALIGN="LEFT">opening/expected/counted cash</TD></TR></TABLE> >];
 company -> shop [label="1:N"]; company -> taxconfig [label="1:1"]; taxconfig -> taxrate [label="configures effective-dated VAT"]; shop -> policy [label="1:1"]; shop -> shopmethod [label="1:N"]; method -> shopmethod [label="1:N"];
 shop -> sale [label="1:N"]; shop -> so [label="1:N"]; so -> deposit [label="1:N"]; deposit -> depapply [label="1:N"]; so -> depapply [label="1:N"];
 shop -> payment [label="1:N"]; employee -> payment [label="actor"]; sale -> payment [label="0..N; refund/payment"]; so -> payment [label="0..N; payment/refund"]; deposit -> payment [label="receipt/refund"];
 payment -> allocation [label="1:N"]; method -> allocation [label="1:N"]; payment -> payment [label="original/refund", style=dashed]; payment -> refundline [label="0..N"];
 sale -> plan [label="0..1 refurb plan"]; plan -> schedule [label="1:N"]; schedule -> settlement [label="1:N"]; payment -> settlement [label="1:N"];
 shop -> approval [label="1:N"]; employee -> approval [label="requester/approver"];
 shop -> cashmove [label="1:N"]; shop -> closing [label="1:N; unique shop/date"]; employee -> closing [label="closer"];
}
